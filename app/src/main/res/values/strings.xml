    <string name="oem_steps_xiaomi">1. Security → Permissions → Autostart: turn on Tuck.\n2. Settings → Apps → Tuck → Battery saver: No restrictions.</string>
    <string name="oem_steps_huawei">Settings → Battery → App launch → Tuck: switch to Manage manually and turn on Auto-launch, Secondary launch and Run in background.</string>
    <string name="oem_steps_oppo">Settings → Battery → App battery management → Tuck: turn on Allow background activity and Allow auto launch.</string>
    <string name="oem_steps_vivo">1. i Manager → App manager → Autostart: turn on Tuck.\n2. Settings → Battery → Background power consumption → Tuck: Allow.</string>
    <string name="oem_steps_samsung">Settings → Battery → Background usage limits → Never sleeping apps: add Tuck.</string>
    <string name="oem_steps_meizu">Phone Manager → Permissions → Background management → Tuck: Allow running in background.</string>
    <string name="oem_steps_other">If starred messages stop arriving, look in your phone\'s battery settings for Tuck and allow it to run in the background.</string>

